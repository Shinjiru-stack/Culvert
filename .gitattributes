# Normalize line endings: store LF in the repository, check out platform default.
* text=auto

# Force LF so GitHub Actions (Linux) and cargo see identical bytes.
*.rs   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.lock text eol=lf

# Windows helper scripts keep CRLF.
*.ps1  text eol=crlf

# Binary assets must never be transformed.
*.ttf  binary
*.ico  binary
*.png  binary
*.exe  binary
